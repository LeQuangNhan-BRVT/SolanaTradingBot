{
    "name": "aegis-solana-terminal",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "test:integration": "tsx --test --test-concurrency=1 tests/integration/**/*.test.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "worker": "tsx src/queue/worker.ts"
    },
    "dependencies": {
        "@solana/wallet-adapter-base": "^0.9.28",
        "@solana/wallet-adapter-react": "^0.15.40",
        "@solana/wallet-adapter-react-ui": "^0.9.40",
        "@solana/web3.js": "^1.99.0",
        "bs58": "^6.0.0",
        "bullmq": "^5.80.9",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "ioredis": "^5.11.1",
        "lucide-react": "^0.468.0",
        "next": "^15.5.27",
        "postgres": "^3.4.9",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.3",
        "@types/react-dom": "^19.0.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.5.27",
        "tsx": "^4.23.1",
        "typescript": "^5.7.2"
    },
    "overrides": {
        "react": "$react",
        "react-dom": "$react-dom"
    }
}
