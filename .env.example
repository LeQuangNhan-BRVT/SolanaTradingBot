SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TRADING_MODE=paper
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis

# Recommended for historical migration backfills. Create a key at dashboard.helius.dev.
HELIUS_API_KEY=
REDIS_URL=redis://localhost:6379

# Shadow mode only requests Jupiter quotes and stores simulated orders. It never signs or sends transactions.
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
JUPITER_PRICE_URL=https://api.jup.ag/price/v3
# Optional; keyless requests are limited to roughly 0.5 req/s.
JUPITER_API_KEY=
SHADOW_ENTRY_LAMPORTS=50000000
SHADOW_SLIPPAGE_BPS=300
SHADOW_STOP_LOSS_BPS=-1500
SHADOW_TAKE_PROFIT_BPS=3000
SHADOW_MAX_POSITION_MINUTES=360
SHADOW_MIN_SIGNAL_SCORE=70
SHADOW_MAX_PRICE_IMPACT_PCT=5
SHADOW_MIN_VOLUME_LIQUIDITY=0.25
SHADOW_MAX_OPEN_POSITIONS=3
SHADOW_MAX_EXPOSURE_LAMPORTS=150000000
SHADOW_DAILY_LOSS_LIMIT_LAMPORTS=-50000000
SHADOW_MAX_CONSECUTIVE_LOSSES=3
SHADOW_REENTRY_COOLDOWN_MINUTES=60

# Optional alert destinations. Leave empty to disable delivery.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard authentication. Set AUTH_REQUIRED=true outside local development.
AUTH_REQUIRED=false
ADMIN_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:3000

# Live trading hard caps (env only). Live also requires TRADING_MODE=live, LIVE_TRADING_ENABLED=true and a keypair.
LIVE_MAX_ENTRY_LAMPORTS=100000000
LIVE_DAILY_SPEND_LIMIT_LAMPORTS=300000000
LIVE_MIN_SOL_RESERVE_LAMPORTS=50000000
# Fast price loop interval for open positions.
PRICE_LOOP_INTERVAL_MS=5000

# Manual trading from a browser wallet (real funds; the wallet signs and sends).
MANUAL_TRADING_ENABLED=false
# Public RPC for the browser. Exposed to the client: never use a URL containing an API key.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Migration discovery: daily Helius credit budget for history-based checks (bundle, total fees).
HELIUS_DAILY_CREDIT_BUDGET=25000
