SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TRADING_MODE=paper
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis

# Recommended for historical migration backfills. Create a key at dashboard.helius.dev.
HELIUS_API_KEY=
REDIS_URL=redis://localhost:6379

# Shadow mode only requests Jupiter quotes and stores simulated orders. It never signs or sends transactions.
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
SHADOW_ENTRY_LAMPORTS=50000000
SHADOW_SLIPPAGE_BPS=300
SHADOW_STOP_LOSS_BPS=-1500
SHADOW_TAKE_PROFIT_BPS=3000
SHADOW_MAX_POSITION_MINUTES=360
SHADOW_MIN_SIGNAL_SCORE=70
SHADOW_MAX_PRICE_IMPACT_PCT=5
SHADOW_MIN_VOLUME_LIQUIDITY=0.25
SHADOW_MAX_OPEN_POSITIONS=3
SHADOW_MAX_EXPOSURE_LAMPORTS=150000000
SHADOW_DAILY_LOSS_LIMIT_LAMPORTS=-50000000
SHADOW_MAX_CONSECUTIVE_LOSSES=3
SHADOW_REENTRY_COOLDOWN_MINUTES=60

# Optional alert destinations. Leave empty to disable delivery.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard authentication. Set AUTH_REQUIRED=true outside local development.
AUTH_REQUIRED=false
ADMIN_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
